# ---------------------------------------------------------------------------
# TerraGo environment. Copy to .env for local development. Never commit .env.
# ---------------------------------------------------------------------------

# --- Game server (apps/game-server) -----------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# PostgreSQL connection (docker compose up -d db gives you this one)
DATABASE_URL=postgres://terrago:terrago_dev_password@localhost:5432/terrago
DB_POOL_MAX=10
# Comma-separated list of web origins allowed to call the API / open sockets
WEB_ORIGINS=http://localhost:3000
# Cookies are Secure by default in production. Leave unset locally (http).
# COOKIE_SECURE=true
# Optional: share the session cookie across subdomains, e.g. .terrago.gg
# COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
# Set to true when running behind a reverse proxy (Caddy/Nginx) so client IPs are read from X-Forwarded-For
TRUST_PROXY=false
# /metrics is open to localhost only unless a token is set (then send X-Metrics-Token)
# METRICS_TOKEN=
MIGRATE_ON_START=true
LOG_LEVEL=info
# Only for local load tests (ignored in production): lets 100 bots register from one IP
DISABLE_RATE_LIMITS=false

# --- Web app (apps/web) ---------------------------------------------------------
# Public URL of the game server (REST + Socket.IO). Baked into the client at build time.
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:4000
