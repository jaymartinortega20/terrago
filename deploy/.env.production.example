# Copy to deploy/.env.production on the VPS. Never commit the real file.
API_DOMAIN=api.terrago.example
WEB_ORIGINS=https://terrago.example,https://www.terrago.example
# Share cookies only if the web and API live on subdomains of the same site:
COOKIE_DOMAIN=
POSTGRES_PASSWORD=change-me-to-a-long-random-string
METRICS_TOKEN=change-me-too
