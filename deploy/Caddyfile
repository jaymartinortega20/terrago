# Automatic HTTPS (Let's Encrypt) and secure WebSockets in front of the game server.
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy game-server:4000 {
		# Socket.IO long-lived connections
		flush_interval -1
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}
